{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "german-sync",
  "main": "src/index.mjs",

  // nodejs_compat gives us node:crypto's createHmac, so the Lambda's token signing ports
  // verbatim rather than being rewritten against WebCrypto. It requires a compatibility_date
  // of at least 2024-09-23.
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // Serve on <name>.<subdomain>.workers.dev — free, no card, no custom domain needed.
  "workers_dev": true,

  "durable_objects": {
    "bindings": [{ "name": "STATE", "class_name": "StateDO" }]
  },

  // new_sqlite_classes (NOT new_classes) is the SQLite-backed storage backend, which is the
  // one available on the Workers Free plan. The KV-backed backend is unavailable to new
  // accounts, so this choice is what keeps the whole thing free.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StateDO"] }
  ],

  "observability": { "enabled": true }
}
