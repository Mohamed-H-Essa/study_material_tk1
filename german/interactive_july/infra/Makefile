# German Study — infra + deploy helpers.
# Terraform is installed at ~/.local/bin/terraform on this machine.
#
# Usage:
#   make init      # one-time: terraform init
#   make apply     # create/update AWS infra (S3 + Lambda)
#   make config    # regenerate ../config.js with the live SYNC_URL
#   make site      # upload the static site to the S3 bucket
#   make deploy    # apply + config + site  (the everyday redeploy)
#   make destroy   # tear everything down

TF      := $(HOME)/.local/bin/terraform
SITEDIR := ..
# Files that make up the static site (everything the browser needs).
AWS     := aws

.PHONY: init apply config site deploy destroy outputs

init:
	$(TF) init

apply:
	$(TF) apply -auto-approve

# Write ../config.js so login.html/sync.js know the live Lambda URL.
config:
	@SYNC_URL=$$($(TF) output -raw sync_url); \
	printf '/* Auto-generated by infra/Makefile (make config). Do not edit by hand. */\nwindow.DE_CONFIG = { SYNC_URL: "%s" };\n' "$$SYNC_URL" > $(SITEDIR)/config.js; \
	echo "wrote config.js -> $$SYNC_URL"

# Upload the static site. --delete keeps the bucket in sync with the repo.
# Excludes repo/infra/doc files that shouldn't be served.
site:
	@BUCKET=$$($(TF) output -raw site_bucket); \
	$(AWS) s3 sync $(SITEDIR) s3://$$BUCKET \
	  --delete \
	  --exclude ".git/*" --exclude "infra/*" --exclude "docs/*" \
	  --exclude "tools/*" \
	  --exclude "*.md" --exclude ".gitignore" --exclude ".DS_Store"; \
	echo "site uploaded to s3://$$BUCKET"

# Seed the admin visibility config (admin-seed.json) into the state bucket. ONE-OFF: this
# OVERWRITES whatever visibility the admin panel has since set, so only run it deliberately.
# Everyday visibility changes belong in admin.html, not here.
admin-seed:
	@BUCKET=$$($(TF) output -raw state_bucket); \
	$(AWS) s3 cp admin-seed.json s3://$$BUCKET/admin/config.json --content-type application/json; \
	echo "seeded admin config -> s3://$$BUCKET/admin/config.json"

deploy: apply config site
	@echo ""; echo "=== deployed ==="; $(TF) output

destroy:
	$(TF) destroy -auto-approve

outputs:
	$(TF) output
